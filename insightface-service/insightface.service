[Unit]
Description=InsightFace sidecar (face-embedding service for Hikvision Attendance)
Documentation=file:/home/attendance/insightface-service/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=attendance
Group=attendance
WorkingDirectory=/home/attendance/insightface-service

# Model config (same defaults as run.sh / app.py)
Environment=INSIGHTFACE_MODEL=buffalo_l
Environment=INSIGHTFACE_CTX_ID=-1
Environment=INSIGHTFACE_DET_SIZE=640

# Run uvicorn straight from the venv (no shell needed).
ExecStart=/home/attendance/insightface-service/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8099

# Model load at startup can take a while on CPU; give it room before "failed".
TimeoutStartSec=120
Restart=on-failure
RestartSec=5

# Logs go to the journal.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=insightface

# Light hardening (safe for a stateless localhost service).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# InsightFace reads the model pack from ~/.insightface, which ProtectHome blocks.
# Allow just that path to stay readable/writable.
ReadWritePaths=/home/attendance/.insightface

[Install]
WantedBy=multi-user.target
